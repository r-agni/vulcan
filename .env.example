# Video AI Retail Analytics - Environment Variables
# Copy this file to .env and fill in your values

# ========== AI Configuration ==========
GEMINI_API_KEY=your_gemini_api_key_here

# ========== Database ==========
DATABASE_URL=sqlite:///./data/database/video_ai.db

# ========== Camera/Video Source ==========
# Options:
#   0, 1, 2, etc. - Webcam index
#   path/to/video.mp4 - Local video file
#   https://youtube.com/watch?v=... - YouTube URL
CAMERA_SOURCE=https://www.youtube.com/watch?v=-1bRhYjw1qE

# ========== Video Settings ==========
CAMERA_FPS=10
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# ========== Face Recognition ==========
FACE_RECOGNITION_TOLERANCE=0.6

# ========== Analytics Settings ==========
TRAJECTORY_HISTORY_SECONDS=30
HEATMAP_UPDATE_INTERVAL_SECONDS=300
OCCUPANCY_LOG_INTERVAL_SECONDS=300

# ========== Application ==========
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
